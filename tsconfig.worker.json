{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "incremental": false,
    "plugins": []
  },
  "include": ["src/**/*.ts", "types/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "app"]
}
