# Copy to /etc/pok-poly-kalshi/worker.env on the VPS.
# Never commit the filled version.

NODE_ENV=production
PORT=8080

# Safety defaults. Keep live off until scripts/verify-live-readiness.sh is green.
ARB_ENABLED=true
ARB_LIVE_TRADING=false
ARB_EXECUTION_CONCURRENCY=1
ARB_MIN_PROFIT_DOLLARS=0.05
ARB_REENTRY_INTERVAL_MS=60000
LIVE_ORDER_SIZE=5
LIVE_MAX_SLIPPAGE_CENTS=1
LIVE_MIN_EXPIRY_MS=120000
LIVE_MAX_TRADES_PER_WINDOW=1
LIVE_COLLATERAL_BUFFER_DOLLARS=0.25
LIVE_QUOTE_MAX_AGE_MS=750
LIVE_QUOTE_SYNC_MAX_SKEW_MS=250
LIVE_MIN_BOOK_DEPTH_SHARES=5
LIVE_ORDER_TIMEOUT_MS=2500
LIVE_HEDGE_MAX_LOSS_DOLLARS=0.02
LIVE_HEDGE_FEE_BUFFER_DOLLARS=0.01
LIVE_PARALLEL_EXECUTION_ENABLED=true
LIVE_HOT_PATH_ENABLED=true
LIVE_HOT_PATH_CACHE_MAX_AGE_MS=5000
LIVE_HOT_PATH_WARM_INTERVAL_MS=1000
LIVE_LOW_LATENCY_HTTP_ENABLED=true
LIVE_POLYMARKET_PRESIGN_ENABLED=false
LIVE_POLYMARKET_SIGNED_ORDER_TTL_MS=5000
LIVE_KALSHI_ORDER_GROUP_ENABLED=true
# Only set after creating a real Kalshi order group with limit LIVE_ORDER_SIZE.
LIVE_KALSHI_ORDER_GROUP_ID=
LIVE_USER_STREAMS_ENABLED=true
LIVE_USER_STREAM_PRETRADE_GRACE_MS=750
LIVE_USER_STREAM_CONFIRM_TIMEOUT_MS=2500
LIVE_PRETRADE_RETRY_ATTEMPTS=2
LIVE_PRETRADE_RETRY_DELAY_MS=100
LIVE_FINAL_RECOVERY_TIMEOUT_MS=3000
LIVE_FINAL_RECOVERY_POLL_MS=250
LIVE_AUTO_RESOLVE_VERIFIED_INCIDENTS=true
LIVE_RECONCILE_BEFORE_TRADE=true

# Existing Railway Postgres is OK to keep using from the VPS.
DATABASE_URL=

# Dashboard bearer token shared with Vercel. Do not expose to the browser.
DASHBOARD_API_TOKEN=

# Kalshi live credentials.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY=
# KALSHI_PRIVATE_KEY_B64=
KALSHI_USER_WS_URL=wss://api.elections.kalshi.com/trade-api/ws/v2

# Polymarket CLOB credentials.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_SIGNATURE_TYPE=3
POLYMARKET_FUNDER_ADDRESS=
POLYMARKET_CHAIN_ID=137
POLYMARKET_CLOB_HOST=https://clob.polymarket.com
POLYMARKET_USER_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/user
POLYMARKET_GEOBLOCK_URL=https://polymarket.com/api/geoblock
LIVE_ORDER_PLACEMENT_MODE=parallel_limit_rest
LIVE_AGGRESSIVE_LIMIT_REST_MS=500
POLYMARKET_ORDER_TYPE=FOK

# Optional derived L2 credentials. Leave blank unless they came from CLOB auth.
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# Polymarket discovery and price-to-beat hydration.
POLYMARKET_LIVE_DATA_WS_URL=wss://ws-live-data.polymarket.com
POLYMARKET_PRICE_TO_BEAT_SYMBOL=btc/usd
POLYMARKET_DISCOVERY_WINDOW_OFFSETS=-1,0,1,2,3,4,5,6
POLYMARKET_PRICE_CAPTURE_TOLERANCE_MS=5000
POLYMARKET_MISSED_OPEN_BACKFILL=true
