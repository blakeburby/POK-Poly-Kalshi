# Copy to /etc/pok-poly-kalshi/worker.env on the VPS.
# Never commit the filled version.

NODE_ENV=production
PORT=8080

# Safety defaults. Set ARB_ENABLED=false to monitor without placing new entries.
ARB_ENABLED=true
ARB_EXECUTION_CONCURRENCY=1
ARB_MIN_PROFIT_DOLLARS=0.01
ARB_REENTRY_INTERVAL_MS=60000
ARB_SCAN_HEARTBEAT_MS=250
LIVE_ORDER_SIZE=5
LIVE_TAKER_PRICE_CUSHION_CENTS=2
LIVE_MIN_EXPIRY_MS=60000
LIVE_MAX_TRADES_PER_WINDOW=3
LIVE_COLLATERAL_BUFFER_DOLLARS=0.25
LIVE_QUOTE_MAX_AGE_MS=750
LIVE_QUOTE_SYNC_MAX_SKEW_MS=250
LIVE_MIN_BOOK_DEPTH_SHARES=10
LIVE_ORDER_TIMEOUT_MS=3500
LIVE_HEDGE_MAX_LOSS_DOLLARS=0.03
LIVE_HEDGE_FEE_BUFFER_DOLLARS=0.01
# Per-contract price floor: cap = 1 - fill - fee - feeBuffer + max(maxLoss, feeBuffer + minCrossTicks*0.01).
# Guarantees the Kalshi hedge cap clears >= this many ticks over breakeven so a tick of book movement
# does not reject the hedge. Effective maxLoss and the post-fill loss lock move together.
LIVE_HEDGE_MIN_CROSS_TICKS=2
# Bounded FOK-then-reprice retries when the Kalshi hedge cleanly 0-fills (never on partial/insufficient/unknown).
LIVE_HEDGE_RETRY_ATTEMPTS=2
LIVE_PARALLEL_EXECUTION_ENABLED=true
LIVE_HOT_PATH_ENABLED=true
LIVE_HOT_PATH_CACHE_MAX_AGE_MS=5000
LIVE_HOT_PATH_WARM_INTERVAL_MS=1000
LIVE_LOW_LATENCY_HTTP_ENABLED=true
LIVE_POLYMARKET_PRESIGN_ENABLED=true
LIVE_POLYMARKET_SIGNED_ORDER_TTL_MS=5000
# Leave unset to require exact LIVE_ORDER_SIZE Polymarket evidence before Kalshi submits.
LIVE_POLYMARKET_FIRST_MIN_FILL_SHARES=
LIVE_POLYMARKET_FIRST_MAX_FILL_SHARES=
LIVE_KALSHI_PREARM_ENABLED=true
LIVE_KALSHI_PREARM_MAX_AGE_MS=5000
LIVE_KALSHI_PREARM_PRICE_POLICY=patch_after_fill
LIVE_KALSHI_ORDER_GROUP_ENABLED=true
# Only set after creating a real Kalshi order group with limit LIVE_ORDER_SIZE.
LIVE_KALSHI_ORDER_GROUP_ID=
LIVE_USER_STREAMS_ENABLED=true
LIVE_USER_STREAM_PRETRADE_GRACE_MS=750
LIVE_USER_STREAM_CONFIRM_TIMEOUT_MS=2500
LIVE_PRETRADE_RETRY_ATTEMPTS=2
LIVE_PRETRADE_RETRY_DELAY_MS=100
LIVE_FINAL_RECOVERY_TIMEOUT_MS=3000
LIVE_FINAL_RECOVERY_POLL_MS=250
LIVE_AUTO_RESOLVE_VERIFIED_INCIDENTS=true
LIVE_AUTO_HARDLOCKS_ENABLED=true
LIVE_PARTIAL_FILL_LOCK_MODE=quarantine
LIVE_MAX_UNRESOLVED_EXPOSURE_DOLLARS=10
LIVE_RECONCILE_BEFORE_TRADE=true

# Existing Railway Postgres is OK to keep using from the VPS.
DATABASE_URL=

# Dashboard bearer token shared with Vercel. Do not expose to the browser.
DASHBOARD_API_TOKEN=

# Kalshi live credentials.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY=
# KALSHI_PRIVATE_KEY_B64=
KALSHI_USER_WS_URL=wss://api.elections.kalshi.com/trade-api/ws/v2

# Polymarket CLOB credentials.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_SIGNATURE_TYPE=3
POLYMARKET_FUNDER_ADDRESS=
POLYMARKET_CHAIN_ID=137
POLYMARKET_CLOB_HOST=https://clob.polymarket.com
POLYMARKET_USER_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/user
POLYMARKET_GEOBLOCK_URL=https://polymarket.com/api/geoblock
LIVE_ORDER_PLACEMENT_MODE=polymarket_first_exact
KALSHI_HEDGE_ORDER_MODE=public_v2
LIVE_KALSHI_HEDGE_TIME_IN_FORCE=fill_or_kill
KALSHI_FIX_HOST=mm.fix.elections.kalshi.com
KALSHI_FIX_PORT=8228
KALSHI_FIX_SENDER_COMP_ID=
KALSHI_FIX_TARGET_COMP_ID=KalshiNR
KALSHI_FIX_HEARTBEAT_SECONDS=10
KALSHI_FIX_CONNECT_TIMEOUT_MS=1500
KALSHI_FIX_ORDER_RESPONSE_TIMEOUT_MS=2500
KALSHI_FIX_USE_DOLLARS=true
KALSHI_FIX_ENABLE_IOC_CANCEL_REPORT=true
KALSHI_FIX_PRESERVE_ORIGINAL_ORDER_QTY=true
LIVE_AGGRESSIVE_LIMIT_REST_MS=500
POLYMARKET_ORDER_TYPE=FAK
LIVE_EXACT_EXPOSURE_REQUIRED=false
LIVE_EXECUTION_QUALITY_GATE_ENABLED=true
LIVE_EXECUTION_QUALITY_LOOKBACK_MS=1800000
LIVE_EXECUTION_QUALITY_SAMPLE_LIMIT=50
LIVE_EXECUTION_QUALITY_MIN_SAMPLES=5
LIVE_EXECUTION_QUALITY_MIN_EXACT_FILL_RATE=0.4
LIVE_KALSHI_MIN_CASH_DOLLARS=5
LIVE_FILL_QUALITY_SCORING_ENABLED=true
LIVE_FILL_QUALITY_GATE_ENABLED=false
LIVE_FILL_QUALITY_MIN_EXPECTED_EDGE=0.01
LIVE_FILL_QUALITY_LOOKBACK_MS=1800000
LIVE_FILL_QUALITY_SAMPLE_LIMIT=200
LIVE_FILL_QUALITY_MIN_SAMPLES=30
LIVE_FILL_QUALITY_MODEL_VERSION=heuristic-v1
LIVE_LEAD_LAG_SCORING_ENABLED=true
LIVE_LEAD_LAG_GATE_ENABLED=false
LIVE_LEAD_LAG_MODEL_VERSION=heuristic-v1
LIVE_LEAD_LAG_WINDOWS_MS=1000,5000,15000,60000
LIVE_LEAD_LAG_MIN_CONFIDENCE=0.65
LIVE_LEAD_LAG_MAX_ADVERSE_SELECTION_SCORE=0.75

# Optional derived L2 credentials. Leave blank unless they came from CLOB auth.
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# Polymarket discovery and price-to-beat hydration.
POLYMARKET_LIVE_DATA_WS_URL=wss://ws-live-data.polymarket.com
POLYMARKET_PRICE_TO_BEAT_SYMBOL=btc/usd
POLYMARKET_DISCOVERY_WINDOW_OFFSETS=-1,0,1,2,3,4,5,6
POLYMARKET_PRICE_CAPTURE_TOLERANCE_MS=5000
POLYMARKET_MISSED_OPEN_BACKFILL=true
