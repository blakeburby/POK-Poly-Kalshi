[Unit]
Description=POK Kalshi/Polymarket cross-venue worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pok
Group=pok
WorkingDirectory=/opt/pok-poly-kalshi
EnvironmentFile=/etc/pok-poly-kalshi/worker.env
ExecStartPre=/usr/bin/npm run migrate
ExecStart=/usr/bin/npm run worker
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/pok-poly-kalshi

[Install]
WantedBy=multi-user.target
