{
  "name": "pok-poly-kalshi",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-platform BTC 15-minute binary options arbitrage scanner for Kalshi and Polymarket.",
  "scripts": {
    "build": "npm run build:worker && npm run build:dashboard",
    "build:worker": "tsc -p tsconfig.worker.json --noEmit",
    "build:dashboard": "next build",
    "dev:dashboard": "next dev",
    "migrate": "tsx src/migrate.ts",
    "fill-quality:calibrate": "tsx scripts/fill-quality-calibrate.ts",
    "lead-lag:calibrate": "tsx scripts/lead-lag-calibrate.ts",
    "worker": "tsx src/index.ts",
    "test": "node --import tsx --test --test-isolation=none tests/*.test.ts tests/*.test.tsx",
    "typecheck": "npm run build:worker",
    "hostinger:precheck": "bash scripts/hostinger-predeploy-check.sh",
    "hostinger:deploy": "bash scripts/hostinger-branch-deploy.sh",
    "hostinger:resume": "bash scripts/hostinger-resume-if-ready.sh",
    "hostinger:stage-ui-quick-order": "bash scripts/hostinger-stage-ui-quick-order.sh",
    "hostinger:stage-parallel-quick": "HOSTINGER_STAGE_PLACEMENT_MODE=parallel_quick bash scripts/hostinger-stage-ui-quick-order.sh",
    "hostinger:stage-fix-ioc": "bash scripts/hostinger-stage-fix-ioc.sh",
    "hostinger:validate-kalshi-ui-cap": "bash scripts/hostinger-validate-kalshi-ui-cap.sh",
    "hostinger:pause-ui-capture": "bash scripts/hostinger-pause-for-kalshi-ui-capture.sh",
    "hostinger:reconcile-quarantines": "bash scripts/hostinger-reconcile-historical-quarantines.sh",
    "kalshi:ui-session:extract": "tsx scripts/extract-kalshi-ui-session-from-har.ts",
    "kalshi:ui-har:sanitize": "tsx scripts/sanitize-kalshi-ui-har.ts",
    "readiness:public": "bash scripts/verify-public-readiness.sh",
    "vps:preflight": "bash scripts/vps-preflight.sh",
    "vps:verify": "bash scripts/verify-live-readiness.sh"
  },
  "dependencies": {
    "@polymarket/clob-client-v2": "^1.0.3",
    "axios": "^1.16.0",
    "framer-motion": "^12.38.0",
    "next": "^16.2.4",
    "pg": "^8.20.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "recharts": "^3.8.1",
    "three": "^0.184.0",
    "undici": "^8.2.0",
    "viem": "^2.48.8",
    "ws": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "@types/pg": "^8.18.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
