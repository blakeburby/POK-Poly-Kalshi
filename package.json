{
  "name": "pok-poly-kalshi",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-platform BTC 15-minute binary options arbitrage scanner for Kalshi and Polymarket.",
  "scripts": {
    "build": "npm run build:worker && npm run build:dashboard",
    "build:worker": "tsc -p tsconfig.worker.json --noEmit",
    "build:dashboard": "next build",
    "dev:dashboard": "next dev",
    "migrate": "tsx src/migrate.ts",
    "worker": "tsx src/index.ts",
    "test": "node --import tsx --test --test-isolation=none tests/*.test.ts tests/*.test.tsx",
    "typecheck": "npm run build:worker"
  },
  "dependencies": {
    "framer-motion": "^12.38.0",
    "next": "^16.2.4",
    "pg": "^8.20.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "recharts": "^3.8.1",
    "three": "^0.184.0",
    "ws": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "@types/pg": "^8.18.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
